# For Cloud / Live Deployment (e.g., Neon.tech, Render, Railway, Supabase)
DATABASE_URL=postgresql://username:password@your-db-host.neon.tech/ecommerce_db?sslmode=require

# JWT Secret Key for Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Allowed Frontend URLs for CORS (comma-separated, optional)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Local Development Fallbacks (used only if DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=your_local_password

